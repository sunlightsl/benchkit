{
  "name": "@sunlightsl/benchkit",
  "version": "0.5.1",
  "description": "Regression testing for agent configurations: verifiable capability and safety task suites for any coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "sunlightsl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunlightsl/benchkit.git"
  },
  "homepage": "https://github.com/sunlightsl/benchkit",
  "bugs": "https://github.com/sunlightsl/benchkit/issues",
  "engines": { "node": ">=20" },
  "bin": { "benchkit": "./bin/benchkit.mjs" },
  "scripts": {
    "selfcheck": "node tests/selfcheck.mjs",
    "e2e": "node tests/mock-agent-e2e.mjs",
    "test:edge": "node tests/runner-edge.mjs",
    "test:acp": "node tests/acp-mock-e2e.mjs"
  },
  "exports": {
    ".": "./src/runner.mjs",
    "./adapters": "./src/adapters.mjs",
    "./plugin": "./src/dsh-plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["bin", "src", "tasks", "docs", "cordis.patch.yml"],
  "keywords": ["agent", "benchmark", "eval", "safety", "regression-testing"]
}
